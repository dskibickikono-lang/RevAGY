---
// Microsoft Clarity (T-022): jeden znacznik dla BaseLayout i PodstronaLayout.
// Sam plik public/assets/js/clarity.js ładuje tag clarity.ms dopiero po zgodzie analitycznej w banerze.
interface Props {
  // Prefiks ścieżki: '' dla stron w korzeniu, '/' dla strony błędu (jak w BaseLayout).
  base?: string;
}

import { zasob } from '../config/zasoby.mjs';

const { base = '' } = Astro.props;
---
<script is:inline src={`${base}${zasob('assets/js/clarity.js')}`} defer></script>
