---
// Zdanie ujawnienia pod opisami wdrożeń (D-034, D-055). Wstaw raz na stronę, po ostatnim <OpisWdrozenia>.
// Tekst wpisuje właściciel w src/data/dowody.mjs (zdanieUjawnienia). Prop `wdrozenia`: identyfikatory wdrożeń,
// których etykiety strona pokazuje (w opisach, kaflach albo FAQ). Zdanie pojawia się tylko wtedy, gdy któreś
// z nich ma etykietę „Grupa KONO” (T-038, przegląd PR #50).
import { DOWODY, pokazUjawnienie } from '../data/dowody.mjs';

interface Props {
  wdrozenia: string[];
}

const { wdrozenia } = Astro.props;
const ujawnienie = pokazUjawnienie(wdrozenia) ? DOWODY.zdanieUjawnienia : null;
---
{ujawnienie && <p class="autor dowod-ujawnienie">{ujawnienie}</p>}
