---
// Widoczna linia z autorem, rolą i datą aktualizacji. Te same dane trafiają do
// WebPage.author i WebPage.dateModified w PodstronaLayout — podaj tę samą datę co `aktualizacja`.
import { AUTOR, dataSlownie, sprawdzDate } from '../config/podstrony.mjs';

interface Props {
  aktualizacja: string;
}

const { aktualizacja } = Astro.props;
sprawdzDate(aktualizacja, 'aktualizacja');
---
<p class="autor">{AUTOR.imie}, {AUTOR.rola} · Aktualizacja: <time datetime={aktualizacja}>{dataSlownie(aktualizacja)}</time></p>
