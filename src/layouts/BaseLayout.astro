---
import { TURNSTILE_SITEKEY } from '../config/kontakt';
import { grafOrganizacji, jsonDoSkryptu } from '../config/marka.mjs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  variant: 'home' | 'subpage' | '404';
  hasForm?: boolean;
}

const { title, description, canonical, robots, variant, hasForm = false } = Astro.props;
const isHome = variant === 'home';
const is404 = variant === '404';
const base = is404 ? '/' : '';
const loadKontaktScript = Boolean(hasForm && TURNSTILE_SITEKEY);
// Dane strukturalne marki tylko na stronie głównej (tam jest kanoniczny opis organizacji)
const jsonLd = isHome ? jsonDoSkryptu(grafOrganizacji()) : null;
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
{description && <meta name="description" content={description}>}
{canonical && <link rel="canonical" href={canonical}>}
{robots && <meta name="robots" content={robots}>}
<meta name="theme-color" content="#ffffff">
{isHome && (
  <>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="REVAGY">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:url" content="https://revagy.pl/">
    <meta property="og:title" content="REVAGY — procesy, które robią się same">
    <meta property="og:description" content="Automatyzacja procesów i wdrożenia AI dla firm B2B. Łączymy CRM, ERP i skrzynki w jeden obieg.">
    <meta property="og:image" content="https://revagy.pl/assets/img/og.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
  </>
)}
<link rel="icon" href={`${base}favicon.ico`} sizes="32x32">
<link rel="icon" href={`${base}assets/img/favicon.svg`} type="image/svg+xml">
{!is404 && <link rel="apple-touch-icon" href={`${base}assets/img/apple-touch-icon.png`}>}
{isHome && (
  <>
    <link rel="manifest" href="site.webmanifest">
    <link rel="preload" href="assets/fonts/onest-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  </>
)}
<link rel="stylesheet" href={`${base}assets/css/styles.css?v=4`}>
{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
</head>
<body>
{!is404 && <a class="skip" href="#start">Przejdź do treści</a>}

{isHome && (
<header class="site-header" id="top">
  <div class="wrap header-row">
    <a class="logo" href="#top" aria-label="REVAGY, strona główna">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor"/><path d="M10 23V9h7.2a4.6 4.6 0 0 1 1.9 8.8L22.5 23h-4l-2.9-4.6H13.5V23zm3.5-7.6h3.3a1.7 1.7 0 0 0 0-3.4h-3.3z" fill="var(--paper)"/></svg>
      <span class="logo-word">REVAGY</span>
    </a>

    <nav class="main-nav" aria-label="Główna nawigacja">
      <div class="nav-item has-panel">
        <button class="nav-link" type="button" aria-expanded="false" aria-controls="panel-rozwiazania">Rozwiązania
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-panel" id="panel-rozwiazania">
          <a href="#mozliwosci"><strong>Automatyzacja procesów</strong><span>Zamówienia, faktury, raporty i obieg dokumentów</span></a>
          <a href="#mozliwosci"><strong>Agenci AI</strong><span>Obsługa zapytań, ofert i zgłoszeń przez całą dobę</span></a>
          <a href="#integracje"><strong>Integracje systemów</strong><span>CRM, ERP, e-commerce i narzędzia zespołu w jednym obiegu</span></a>
          <a href="#mozliwosci"><strong>Analityka i raporty</strong><span>Dane z wielu źródeł w jednym pulpicie</span></a>
        </div>
      </div>
      <div class="nav-item has-panel">
        <button class="nav-link" type="button" aria-expanded="false" aria-controls="panel-dzialy">Dla działów
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-panel" id="panel-dzialy">
          <a href="#zastosowania"><strong>Sprzedaż</strong><span>Kwalifikacja leadów, oferty, follow-upy</span></a>
          <a href="#zastosowania"><strong>Finanse</strong><span>Faktury kosztowe, windykacja, uzgodnienia</span></a>
          <a href="#zastosowania"><strong>Obsługa klienta</strong><span>Odpowiedzi, statusy zamówień, reklamacje</span></a>
          <a href="#zastosowania"><strong>Operacje i HR</strong><span>Onboarding, grafiki, zamówienia wewnętrzne</span></a>
        </div>
      </div>
      <a class="nav-link" href="#proces">Jak wdrażamy</a>
      <a class="nav-link" href="#pakiety">Pakiety</a>
      <a class="nav-link" href="#faq">FAQ</a>
    </nav>

    <div class="header-actions">
      <a class="btn btn-ghost" href="#kalkulator">Policz zwrot</a>
      <a class="btn btn-dark" href="#kontakt">Umów konsultację</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Otwórz menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="wrap" aria-label="Menu mobilne">
      <a href="#mozliwosci">Rozwiązania</a>
      <a href="#zastosowania">Dla działów</a>
      <a href="#proces">Jak wdrażamy</a>
      <a href="#kalkulator">Policz zwrot</a>
      <a href="#pakiety">Pakiety</a>
      <a href="#faq">FAQ</a>
      <a class="btn btn-dark btn-lg" href="#kontakt">Umów bezpłatną konsultację</a>
    </nav>
  </div>
</header>
)}

{variant === 'subpage' && (
<header class="site-header is-scrolled" id="top">
  <div class="wrap header-row">
    <a class="logo" href="./" aria-label="REVAGY, strona główna">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor"/><path d="M10 23V9h7.2a4.6 4.6 0 0 1 1.9 8.8L22.5 23h-4l-2.9-4.6H13.5V23zm3.5-7.6h3.3a1.7 1.7 0 0 0 0-3.4h-3.3z" fill="var(--paper)"/></svg>
      <span class="logo-word">REVAGY</span>
    </a>
    <div class="header-actions" style="margin-left:auto">
      <a class="btn btn-ghost" href="./">Strona główna</a>
      <a class="btn btn-dark" href="./#kontakt">Umów konsultację</a>
    </div>
  </div>
</header>
)}

{is404 && (
<header class="site-header" id="top">
  <div class="wrap header-row">
    <a class="logo" href="/" aria-label="REVAGY, strona główna">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor"/><path d="M10 23V9h7.2a4.6 4.6 0 0 1 1.9 8.8L22.5 23h-4l-2.9-4.6H13.5V23zm3.5-7.6h3.3a1.7 1.7 0 0 0 0-3.4h-3.3z" fill="var(--paper)"/></svg>
      <span class="logo-word">REVAGY</span>
    </a>
    <div class="header-actions" style="margin-left:auto">
      <a class="btn btn-dark" href="/#kontakt">Umów konsultację</a>
    </div>
  </div>
</header>
)}

<slot />

{isHome && (
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="#top" aria-label="REVAGY, do góry strony">
          <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="currentColor"/><path d="M10 23V9h7.2a4.6 4.6 0 0 1 1.9 8.8L22.5 23h-4l-2.9-4.6H13.5V23zm3.5-7.6h3.3a1.7 1.7 0 0 0 0-3.4h-3.3z" fill="var(--paper)"/></svg>
          <span class="logo-word">REVAGY</span>
        </a>
        <p>Automatyzacja procesów i wdrożenia AI dla firm B2B.</p>
      </div>
      <nav aria-label="Rozwiązania">
        <h4>Rozwiązania</h4>
        <a href="#mozliwosci">Automatyzacja procesów</a><a href="#mozliwosci">Agenci AI</a><a href="#integracje">Integracje</a><a href="#mozliwosci">Analityka</a>
      </nav>
      <nav aria-label="Dla działów">
        <h4>Dla działów</h4>
        <a href="#zastosowania">Sprzedaż</a><a href="#zastosowania">Finanse</a><a href="#zastosowania">Obsługa klienta</a><a href="#zastosowania">Logistyka</a>
      </nav>
      <nav aria-label="Firma">
        <h4>Firma</h4>
        <a href="#proces">Jak wdrażamy</a><a href="#pakiety">Pakiety</a><a href="#bezpieczenstwo">Bezpieczeństwo</a><a href="#faq">FAQ</a>
      </nav>
      <nav aria-label="Kontakt">
        <h4>Kontakt</h4>
        <a href="#kontakt">Umów konsultację</a><a href="mailto:kontakt@revagy.pl">kontakt@revagy.pl</a><a href="tel:+48504037538">+48 504 037 538</a><a href="#kalkulator">Kalkulator zwrotu</a>
      </nav>
    </div>
    <div class="footer-legal">
      <p>© 2026 REVAGY · Dawid Skibicki · ul. Gabriela Narutowicza 7/7, 14-200 Iława · NIP 7441749535 · REGON 389229155</p>
      <p><a href="polityka-prywatnosci.html">Polityka prywatności</a> · <button type="button" class="link-btn" data-consent-open>Ustawienia prywatności</button> · <a href="mailto:kontakt@revagy.pl">kontakt@revagy.pl</a></p>
      <p>Widoki ekranów i nazwy firm w przykładach są poglądowe. Nazwy systemów należą do ich właścicieli i wskazują przykładowe kierunki integracji.</p>
    </div>
  </div>
</footer>
)}

{variant === 'subpage' && (
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-legal" style="margin-top:0">
      <p>© 2026 REVAGY · Dawid Skibicki · ul. Gabriela Narutowicza 7/7, 14-200 Iława · NIP 7441749535 · REGON 389229155</p>
      <p><a href="./">Strona główna</a> · <button type="button" class="link-btn" data-consent-open>Ustawienia prywatności</button> · <a href="mailto:kontakt@revagy.pl">kontakt@revagy.pl</a></p>
    </div>
  </div>
</footer>
)}

{loadKontaktScript && <script is:inline src={`${base}assets/js/kontakt.js?v=1`} defer></script>}
{isHome && <script is:inline src="assets/js/app.js?v=4" defer></script>}
<script is:inline src={`${base}assets/js/analytics.js?v=4`} defer></script>
</body>
</html>
