---
// Układ podstron (D-031). BaseLayout.astro zostaje bez zmian.
// Nagłówek i stopka to kopia znaczników strony głównej z BaseLayout.astro (pełne menu,
// menu mobilne, pełna stopka). Pozycje menu i stopki prowadzą do sekcji strony głównej (./#sekcja),
// z wyjątkiem „Finanse” (finanse.html, T-021) i „Kadry i płace” (kadry-i-place.html, T-034).
// Adres kanoniczny, dane do udostępnień i dane strukturalne powstają z właściwości,
// więc strona nie wpisuje ich ręcznie.
import { MARKA, jsonDoSkryptu } from '../config/marka.mjs';
import { AUTOR, adresStrony, sprawdzDate } from '../config/podstrony.mjs';
import { stanFilmu, videoObject } from '../config/filmy.mjs';
import Clarity from '../components/Clarity.astro';
import { zasob } from '../config/zasoby.mjs';

interface Pytanie {
  pytanie: string;
  odpowiedz: string;
}

interface Usluga {
  nazwa: string;
  opis: string;
  rodzaj?: string;
}

interface Props {
  // Nazwa pliku wynikowego, np. 'integracja-systemow.html'. Z niej powstaje adres strony.
  plik: string;
  // Tytuł karty (<title>, og:title), np. '… | REVAGY'.
  tytul: string;
  // Opis dla wyszukiwarek (meta description, og:description).
  opis: string;
  // Nazwa strony w ścieżce nawigacji (BreadcrumbList) i w WebPage.name.
  okruszek: string;
  // Data ostatniej zmiany treści, RRRR-MM-DD (WebPage.dateModified).
  aktualizacja: string;
  // Opis usługi do danych strukturalnych (Service). Pomiń na stronach bez usługi.
  usluga?: Usluga;
  // Ta sama lista, którą strona przekazuje do <Pytania>. Z niej powstaje FAQPage.
  pytania?: Pytanie[];
  // Nazwa miejsca na film z src/config/filmy.mjs. VideoObject pojawia się tylko w stanie „film”.
  film?: string;
  robots?: string;
}

const { plik, tytul, opis, okruszek, aktualizacja, usluga, pytania = [], film, robots } = Astro.props;

for (const [pole, wartosc] of Object.entries({ tytul, opis, okruszek })) {
  if (typeof wartosc !== 'string' || !wartosc.trim()) throw new Error(`PodstronaLayout (${plik}): puste pole „${pole}”.`);
}
sprawdzDate(aktualizacja, 'aktualizacja');

const adres = adresStrony(plik);
const organizacja = { '@id': `${MARKA.url}#organizacja` };
const stanMiejscaNaFilm = film ? stanFilmu(film) : null;

const graf: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': `${adres}#strona`,
    url: adres,
    name: okruszek,
    headline: tytul,
    description: opis,
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${MARKA.url}#strona` },
    publisher: organizacja,
    author: { '@type': 'Person', name: AUTOR.imie, jobTitle: AUTOR.stanowisko, worksFor: organizacja },
    dateModified: aktualizacja,
    breadcrumb: { '@id': `${adres}#okruszki` },
    ...(usluga ? { about: { '@id': `${adres}#usluga` } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${adres}#okruszki`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: MARKA.url },
      { '@type': 'ListItem', position: 2, name: okruszek, item: adres },
    ],
  },
];
if (usluga) {
  graf.push({
    '@type': 'Service',
    '@id': `${adres}#usluga`,
    name: usluga.nazwa,
    description: usluga.opis,
    ...(usluga.rodzaj ? { serviceType: usluga.rodzaj } : {}),
    url: adres,
    provider: organizacja,
    areaServed: { '@type': 'Country', name: 'Polska' },
  });
}
if (pytania.length) {
  graf.push({
    '@type': 'FAQPage',
    '@id': `${adres}#pytania`,
    isPartOf: { '@id': `${adres}#strona` },
    inLanguage: 'pl-PL',
    mainEntity: pytania.map((q) => ({
      '@type': 'Question',
      name: q.pytanie,
      acceptedAnswer: { '@type': 'Answer', text: q.odpowiedz },
    })),
  });
}
const wideo = videoObject(stanMiejscaNaFilm, MARKA.url, adres);
if (wideo) graf.push(wideo);

const jsonLd = jsonDoSkryptu({ '@context': 'https://schema.org', '@graph': graf });
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{tytul}</title>
<meta name="description" content={opis}>
<link rel="canonical" href={adres}>
{robots && <meta name="robots" content={robots}>}
<meta name="theme-color" content="#ffffff">
<meta property="og:type" content="website">
<meta property="og:site_name" content={MARKA.nazwa}>
<meta property="og:locale" content="pl_PL">
<meta property="og:url" content={adres}>
<meta property="og:title" content={tytul}>
<meta property="og:description" content={opis}>
<meta property="og:image" content={MARKA.obraz}>
