---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TURNSTILE_SITEKEY, KONTAKT_NOTICE } from '../config/kontakt';
---
<BaseLayout
  title="REVAGY — automatyzacja i AI dla agencji pracy, firm HR i B2B"
  description="Automatyzacja kadr, rekrutacji i obsady dla agencji pracy i firm HR. Spinamy HRappkę, nexo, TAXXO i Pipedrive — bez wymiany systemów. Pierwsza automatyzacja w 14 dni, audyt 1 990 zł z 14 dniami na pełny zwrot."
  canonical="https://revagy.pl/"
  variant="home"
  activeNav="home"
  showJourney={true}
  hasForm={Boolean(TURNSTILE_SITEKEY)}
>
<main id="start">

  <!-- 1. HERO -->
  <section class="hero-outer" data-step-label="01 · Start i pozycjonowanie">
    <div class="hero" data-hero>
      <div class="hero-media" data-parallax>
        <video class="hero-video" data-autoplay muted loop playsinline preload="metadata" poster="/assets/video/hero-flow.jpg">
          <source src="/assets/video/hero-flow.webm" type="video/webm">
          <source src="/assets/video/hero-flow.mp4" type="video/mp4">
        </video>
      </div>
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="chip chip-glass load-in" style="--d:0ms">Automatyzacja i AI dla agencji pracy, firm HR i operacji B2B</p>
        <h1 class="display load-in" style="--d:80ms">Procesy, które robią się same</h1>
        <p class="hero-lead load-in" style="--d:160ms">Automatyzacja kadr, rekrutacji i obsady dla agencji pracy i firm HR. Spinamy HRappkę, nexo, TAXXO i Pipedrive — bez wymiany systemów. Jeden partner od pierwszej integracji do agentów AI.</p>
        <div class="hero-subproof load-in" style="--d:200ms">
          <span>14 klientów (16/16 zgód na referencje)</span>
          <span>Pierwsza automatyzacja w 14 dni</span>
          <span>Audyt 1 990 zł · 14 dni na pełny zwrot</span>
        </div>
        <div class="hero-cta load-in" style="--d:240ms">
          <a class="btn btn-accent btn-lg" href="#kontakt" data-track="Hero: Umów audyt (1 990 zł)">Umów audyt (1 990 zł, 14 dni na zwrot)</a>
          <a class="btn btn-glass btn-lg" href="#film" data-track="Hero: Zobacz agenta w akcji">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" fill="currentColor"/></svg>
            Zobacz agenta w akcji
          </a>
        </div>
        <p class="hero-note load-in" style="--d:300ms">Audyt (3–5 dni rob.) wycenia Wasz Excel w złotówkach i jest w 100% odliczany od wdrożenia przy zamówieniu w 30 dni.</p>
      </div>

      <aside class="hero-feed load-in" style="--d:420ms" aria-label="Podgląd na żywo z działających wdrożeń w portfolio REVAGY">
        <div class="feed-head"><span class="pulse" aria-hidden="true"></span>Na żywo w portfolio<span class="feed-tag">14 klientów</span></div>
        <ul class="feed-list" data-feed>
          <li><span class="feed-ico i-doc">DOC</span><span><b>APT WORK · tablet na hali</b>Umowa → podpis → nexo i HRappka</span><time>~10 min</time></li>
          <li><span class="feed-ico i-lead i-rose">HR</span><span><b>Personel Job · alert zezwoleń</b>Powiadomienie kadr 30 dni przed końcem</span><time>30 dni</time></li>
          <li><span class="feed-ico i-box i-ok">ADS</span><span><b>HR KADRA · Meta → HRappka</b>Kandydat w systemie i mail zwrotny</span><time>≤ 5 min</time></li>
          <li><span class="feed-ico i-mail i-light">CEO</span><span><b>HR KONO S.A. · pulpit grupy</b>4 publikacje dziennie w 12 s, gotowe rano</span><time>07:30</time></li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- STATYSTYKI DOWODOWE -->
  <section class="stats wrap" aria-label="REVAGY w liczbach">
    <div class="stat reveal">
      <p class="stat-num"><span data-count="14">14</span></p>
      <p class="stat-label">klientów w portfolio (16 podmiotów, 16/16 zgód na case study, logo i rekomendację)</p>
    </div>
    <div class="stat reveal" style="--d:70ms">
      <p class="stat-num"><span data-count="14">14</span> dni</p>
      <p class="stat-label">do pierwszej działającej automatyzacji bez ruszania obecnych systemów</p>
    </div>
    <div class="stat reveal" style="--d:140ms">
      <p class="stat-num"><span data-count="0">0</span> / 16</p>
      <p class="stat-label">projektów zatrzymanych przez opór zespołów — wdrażamy zmianę razem z ludźmi</p>
    </div>
    <div class="stat reveal" style="--d:210ms">
      <p class="stat-num"><span data-count="120">120</span>+</p>
      <p class="stat-label">systemów łączonych przez API i webhooki: HRappka, nexo, TAXXO, Pipedrive, Comarch, enova</p>
    </div>
  </section>

  <!-- 2. LOGO WALL -->
  <section class="section wrap" id="klienci" data-step-label="02 · Klienci i referencje">
    <div class="logo-wall-box reveal">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:12px;">
        <div>
          <span class="mono" style="color:var(--accent-deep);font-weight:700;">PORTFOLIO REVAGY · 10 Z 16 PODMIOTÓW TO AGENCJE PRACY I FIRMY HR</span>
          <h2 class="h3" style="margin-top:4px;">Zaufali nam w kadrach, rekrutacji, sprzedaży B2B i operacjach</h2>
        </div>
        <a class="btn btn-outline" href="/realizacje.html" data-track="LogoWall: Wszystkie realizacje">Zobacz wszystkie 16 realizacji →</a>
      </div>

      <div class="logo-group-highlight">
        <div class="logo-group-pills">
          <span class="logo-pill logo-pill-dark">HR KONO S.A.</span>
          <span class="logo-pill logo-pill-dark">HR KADRA</span>
          <span class="logo-pill logo-pill-dark">HR BRAND SELL</span>
        </div>
        <span class="mono">Grupa logo: wielokrotny klient w grupie — każdy projekt kupiony osobno (osobny discovery, design, plan i wdrożenie).</span>
      </div>

      <div class="logo-grid">
        <span class="logo-pill">APT WORK</span>
        <span class="logo-pill">Personel Job</span>
        <span class="logo-pill">Kono (Grupa KONO)</span>
        <span class="logo-pill">COMPADRES</span>
        <span class="logo-pill">SERVUS</span>
        <span class="logo-pill">KL DEVELOPMENT</span>
        <span class="logo-pill">Dobra Praca PL</span>
        <span class="logo-pill">Dobra Praca Sp. z o.o.</span>
        <span class="logo-pill">HR KADRA BIS</span>
        <span class="logo-pill">Labor APT <span class="badge badge-pilot">Pilotaż</span></span>
        <span class="logo-pill">KONO STAL SERVIS <span class="badge badge-pilot">Pilotaż</span></span>
        <span class="logo-pill">HR KONO — nowy panel <span class="badge badge-pilot">Pilotaż</span></span>
        <span class="logo-pill">Nexora <span class="badge badge-wip">W trakcie</span></span>
        <span class="logo-pill">Personal <span class="badge badge-wip">W trakcie</span></span>
      </div>
    </div>
  </section>

  <!-- 3. MOŻLIWOŚCI: BENTO KINETIC SHOWCASE -->
  <section class="section wrap" id="mozliwosci" data-step-label="03 · Możliwości w akcji">
    <header class="section-head reveal">
      <span class="kicker">Krok 1 ścieżki · Jak wygląda praca po spięciu systemów</span>
      <h2 class="h2">Jeden partner od&nbsp;pierwszej integracji do&nbsp;agentów AI</h2>
      <p class="lead">Zaczynamy od procesu, który kosztuje Wasze kadry, rekrutację lub sprzedaż najwięcej godzin. Spinamy systemy, które już macie, a powtarzalne przepisywanie oddajemy automatom.</p>
    </header>

    <div class="bento">
      <article class="card card-mist span-7 reveal">
        <div class="card-copy">
          <span class="mono">Prod. 1 &amp; Prod. 2 · Obieg dokumentów i obsady (APT WORK)</span>
          <h3 class="h3">Od leada i dokumentu do gotowej obsady</h3>
          <p>Umowa z nexo trafia na tablet koordynatora na hali, a po podpisie pracownika wraca prosto do nexo i HRappki w ~10 minut zamiast ~3 dni (~12 h/tydz. mniej w kadrach).</p>
        </div>
        <div class="mock mock-pipeline" aria-hidden="true">
          <div class="pipe-col"><span class="pipe-title">Nowe</span><i></i><i></i></div>
          <div class="pipe-col"><span class="pipe-title">Weryfikacja</span><i></i></div>
          <div class="pipe-col"><span class="pipe-title">W systemie</span><i></i></div>
          <div class="pipe-card">
            <span class="pc-name">APT WORK · ~40 umów/tydz.</span>
            <span class="pc-meta">nexo → Drive → Tablet → HRappka</span>
            <span class="pc-badges"><em class="b1">nowa umowa</em><em class="b2">podpis tablet</em><em class="b3">w systemie ~10 min</em></span>
          </div>
        </div>
      </article>

      <article class="card card-night span-5 reveal" style="--d:80ms">
        <div class="card-copy">
          <span class="mono" style="color:var(--accent);">Prod. 6 · Rekrutacja B2C (HR KADRA)</span>
          <h3 class="h3">Kandydat obsłużony w ≤ 5 minut</h3>
          <p>Leady z Meta Ads wpadają do HRappki co 5 minut zamiast czekać ~48 h w arkuszu. Kandydat od razu dostaje maila, co daje ~30% więcej kontaktów tego samego dnia.</p>
        </div>
        <div class="mock mock-chat" aria-hidden="true">
          <p class="bubble in c1">Meta Lead Ads: M. Nowak · Operator wózka UDT · zmiana poranna, dostępny od poniedziałku.</p>
          <div class="chat-slot">
            <p class="bubble typing c2"><span></span><span></span><span></span></p>
            <p class="bubble out c3">Kandydat zapisany w HRappce (≤ 5 min). Wysłano mail zwrotny z ankietą i powiadomiono rekrutera.</p>
          </div>
          <p class="bubble note c4">HR KADRA · ~600 leadów/mies. · ~10 h/tydz. mniej przepisywania</p>
        </div>
      </article>

      <article class="card card-accent span-5 reveal">
        <div class="card-copy">
          <span class="mono">Prod. 2, 3 &amp; 13 · Kadry, zezwolenia i umowy po NIP</span>
          <h3 class="h3">Dokumenty kadrowe bez przepisywania</h3>
          <p>Umowy klientów po NIP powstają w ~2 minuty (z ~45 min), a dashboard kadr ostrzega o wygasających zezwoleniach 30 dni wcześniej — z zahashowanymi identyfikatorami bez PII.</p>
        </div>
        <div class="mock mock-doc" aria-hidden="true">
          <div class="doc">
            <span class="doc-title">Umowa / Zezwolenie</span>
            <span class="doc-line w70"></span><span class="doc-line w45"></span>
            <span class="doc-line w85"></span><span class="doc-line w60"></span>
            <span class="doc-line w30 strong"></span>
            <span class="scan"></span>
          </div>
          <ul class="doc-fields">
            <li class="f1"><span>ID raportu</span><b>NIP / PESEL hash</b></li>
            <li class="f2"><span>Obieg hali</span><b>Podpis tablet</b></li>
            <li class="f3"><span>Alert kadr</span><b>Zezwolenie -30 dni</b></li>
            <li class="f4 ok"><b>Zapisano w nexo i HRappce</b></li>
          </ul>
        </div>
      </article>

      <article class="card card-video span-7 reveal" style="--d:80ms">
        <video data-autoplay muted loop playsinline preload="none" poster="/assets/video/dashboard.jpg">
          <source src="/assets/video/dashboard.webm" type="video/webm">
          <source src="/assets/video/dashboard.mp4" type="video/mp4">
        </video>
        <div class="card-copy on-video">
          <span class="mono" style="color:var(--accent);">Prod. 5 · KONO OS (HR KONO S.A.)</span>
          <h3 class="h3">Pulpit zarządu i kadr o 7:30</h3>
          <p>Pipedrive, HRappka, nexo i TAXXO spięte w jeden kontrakt danych pilnowany przez 2011 testów automatycznych. 4 publikacje dziennie w 12 sekund — raport z ~6 h/tydz. do 0 h.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- 4. TRIGGERY AGENCJI: INTERACTIVE CAROUSEL -->
  <section class="section" id="triggery" data-step-label="04 · Triggery agencji">
    <div class="wrap carousel-head reveal">
      <div>
        <span class="kicker">Dla agencji pracy i firm HR (5–250 osób w biurze)</span>
        <h2 class="h2">Pięć momentów, w&nbsp;których Excel przestaje działać (+&nbsp;impuls KSeF)</h2>
        <p class="lead">Przesuń karty lub użyj strzałek. Każda z tych sytuacji to moment, w którym ręczne przepisywanie zaczyna kosztować marżę, ludzi albo kary.</p>
      </div>
      <div class="carousel-nav">
        <button class="round-btn" type="button" data-car-prev aria-label="Poprzednie karty">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 4 6 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="round-btn" type="button" data-car-next aria-label="Następne karty">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <div class="carousel" data-carousel tabindex="0" aria-label="Triggery zakupowe agencji pracy i firm HR">
      <article class="use use-night">
        <span class="use-tag">01 · Legalizacja cudzoziemców</span>
        <h3 class="h3">Wygasłe zezwolenie wychodzi na jaw po terminie</h3>
        <ul>
          <li>Alert o końcu ważności 30 dni wcześniej (Personel Job)</li>
          <li>Automatyczne zestawienia z HRappki (~5 h/tydz. mniej)</li>
          <li>Warstwa raportowa bez PII (identyfikatory zahashowane)</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M60 14 20 30v28c0 24 17 42 40 48 23-6 40-24 40-48V30z" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/><path d="M60 44v20M60 78h.01" stroke="currentColor" stroke-width="8" stroke-linecap="round"/></svg>
      </article>

      <article class="use use-mist">
        <span class="use-tag">02 · Obsada i start u klienta</span>
        <h3 class="h3">Start ludzi dzień później przez druk i kuriera</h3>
        <ul>
          <li>Umowa pracownika na tablecie w ~10 min zamiast ~3 dni (APT WORK)</li>
          <li>Generator umowy B2B po NIP w ~2 min zamiast ~45 min (COMPADRES)</li>
          <li>Automatyczny zapis podpisanych dokumentów w nexo i HRappce</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><rect x="24" y="12" width="72" height="96" rx="12" fill="none" stroke="currentColor" stroke-width="7"/><path d="M42 42h36M42 60h36M42 78h18" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
      </article>

      <article class="use use-accent">
        <span class="use-tag">03 · Rekrutacja B2C</span>
        <h3 class="h3">Lead z Meta Ads obrobiony po 2 dniach</h3>
        <ul>
          <li>Kandydat z reklamy w HRappce w ≤ 5 min (HR KADRA)</li>
          <li>Natychmiastowy mail i SMS, zanim kandydat zamknie reklamę</li>
          <li>~30% więcej kontaktów tego samego dnia i ~10 h/tydz. mniej przepisywania</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M14 96 44 62l20 16 42-52" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="106" cy="26" r="9" fill="currentColor"/></svg>
      </article>

      <article class="use use-plum">
        <span class="use-tag">04 · Finanse i marża</span>
        <h3 class="h3">Marża i rozjazdy załogi widoczne po fakcie</h3>
        <ul>
          <li>Pulpit grupy o 7:30 łączący Pipedrive, HRappkę, nexo i TAXXO</li>
          <li>Wykryty rozjazd stanu załogi 568 vs 539 między źródłami (HR KONO S.A.)</li>
          <li>Plugin rentowności per klient dla COO (koszt pracodawcy vs przychód)</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="7"/><path d="M60 60V16a44 44 0 0 1 38 66z" fill="currentColor"/></svg>
      </article>

      <article class="use use-mist">
        <span class="use-tag">05 · Ciągłość back-office</span>
        <h3 class="h3">Odejście kadrowej zabiera wiedzę o wyjątkach</h3>
        <ul>
          <li>Baza wiedzy super-brain z 63 tys. wiadomości → 167 stron wiki (HR KADRA BIS)</li>
          <li>Odpowiedź „jak to robimy?” w ~1 min i wdrożenie nowej osoby ~30% krótsze</li>
          <li>0 utraconej wiedzy przy rotacji w biurze</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="40" r="20" fill="none" stroke="currentColor" stroke-width="7"/><path d="M20 106a40 40 0 0 1 80 0" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
      </article>

      <article class="use use-night">
        <span class="use-tag">06 · Impuls KSeF i ERP</span>
        <h3 class="h3">KSeF wymusza uporządkowanie obiegu faktur</h3>
        <ul>
          <li>Walidacja i przypisanie kosztów do obiektów / projektów (jak w TAXXO)</li>
          <li>Integracja z nexo, Comarch ERP, enova365 i TAXXO bez wymiany systemu</li>
          <li>Człowiek zatwierdza wyjątki i dokumenty niezaakceptowane</li>
        </ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M60 12 102 34v52L60 108 18 86V34z" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/><path d="M18 34 60 58l42-24M60 58v50" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/></svg>
      </article>
    </div>
  </section>

  <!-- 5. PWE GŁÓWNE + KATALOG PRODUKTÓW APT/HR -->
  <section class="section wrap" id="produkty" data-step-label="05 · Produkty APT/HR i PWE">
    <div class="section-head reveal">
      <span class="kicker">Dlaczego zarządy i kadry wybierają REVAGY</span>
      <h2 class="h2">Sprawdzone wartości i gotowe moduły od&nbsp;3&nbsp;900&nbsp;zł</h2>
      <p class="lead">Nie sprzedajemy kolejnego modułu zamkniętego w silosie. Spinamy Wasze systemy, sprzedajemy zmianę zespołowi i podajemy ceny „od” przed pierwszą rozmową.</p>
    </div>

    <div class="grid-3" id="wartosci" style="margin-bottom:48px;">
      <article class="card card-night reveal">
        <span class="badge badge-p0" style="align-self:flex-start;">Obsł. 1 · Scoring 50/50</span>
        <h3 class="h3">Sprzedajemy wdrożenie pracownikom</h3>
        <p class="muted">Zespół nie blokuje zmian ze strachu o etat. <strong>0 z 16 projektów</strong> zatrzymanych przez opór zespołów — najpierw prowadzimy warsztat z kadrami i rekrutacją.</p>
      </article>
      <article class="card reveal" style="--d:70ms">
        <span class="badge badge-disclosure" style="align-self:flex-start;">Prod. 1 · Scoring 40/50</span>
        <h3 class="h3">Bez wymiany systemów</h3>
        <p class="muted">Moduł dostawcy widzi tylko własną bazę. Łączymy HRappkę, nexo, TAXXO, Pipedrive, Comarch i enova365 w jeden spójny kontrakt danych.</p>
      </article>
      <article class="card reveal" style="--d:140ms">
        <span class="badge badge-disclosure" style="align-self:flex-start;">Obsł. 2 · Scoring 50/50</span>
        <h3 class="h3">Naprawa zanim zauważycie awarię</h3>
        <p class="muted">Monitoring, diagnostyka i poprawka przed zgłoszeniem użytkownika. Wiążące czasy reakcji wg pakietu (1 dzień rob. w Start, do 4 h w Scale, agent-opiekun 24/7 w Enterprise).</p>
      </article>
    </div>

    <div class="section-head left reveal">
      <span class="kicker">Katalog produktów APT / HR · od 3 900 zł + 290–790 zł/mies.</span>
      <h3 class="h2">Pięć powtarzalnych produktów sprawdzonych na produkcji</h3>
      <p class="lead">Możecie zacząć od jednego modułu produktowego i rozwijać kolejne procesy w tym samym układzie.</p>
    </div>

    <div class="grid-3">
      <article class="card reveal">
        <span class="mono">Produkt 01 · Dowód: APT WORK</span>
        <h3 class="h3">Obieg dokumentów z podpisem na tablecie</h3>
        <p class="muted">nexo → Google Drive → tablet koordynatora na hali → podpis pracownika → powrót do nexo i HRappki.</p>
        <p><strong>~3 dni → ~10 min</strong> · ~12 h/tydz. mniej w kadrach</p>
        <p class="mono" style="color:var(--accent-deep);">od 3 900 zł + 290–790 zł/mies.</p>
        <a class="btn btn-outline" style="margin-top:auto" href="/produkty/obieg-dokumentow.html" data-track="Produkt 01: Obieg dokumentów">Karta produktu →</a>
      </article>

      <article class="card reveal" style="--d:60ms">
        <span class="mono">Produkt 02 · Dowód: Personel Job</span>
        <h3 class="h3">Dashboard kadr i alert zezwoleń 30 dni</h3>
        <p class="muted">Automatyczne zestawienia z HRappki (zezwolenia, czas pracy, stan załogi) bez PII w warstwie raportowej (hashowane ID).</p>
        <p><strong>Alert 30 dni wcześniej</strong> · ~5 h/tydz. mniej raportów</p>
        <p class="mono" style="color:var(--accent-deep);">od 3 900 zł + 290–790 zł/mies.</p>
