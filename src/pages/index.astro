---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TURNSTILE_SITEKEY, KONTAKT_NOTICE } from '../config/kontakt';
import { zasob } from '../config/zasoby.mjs';
---
<BaseLayout
  title="REVAGY — automatyzacja i AI dla firm B2B"
  description="REVAGY automatyzuje procesy i wdraża AI w firmach B2B: sprzedaż, finanse, obsługa klienta i operacje. Zacznij od bezpłatnej konsultacji jednego procesu."
  canonical="https://revagy.pl/"
  variant="home"
  hasForm={Boolean(TURNSTILE_SITEKEY)}
>
<main id="start">

  <!-- HERO -->
  <section class="hero-outer">
    <div class="hero" data-hero>
      <div class="hero-media" data-parallax>
        <video class="hero-video" id="hero-video" data-autoplay muted loop playsinline preload="metadata" poster={zasob('assets/video/hero-flow.jpg')}>
          <source src={zasob('assets/video/hero-flow.webm')} type="video/webm">
          <source src={zasob('assets/video/hero-flow.mp4')} type="video/mp4">
        </video>
      </div>
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="chip chip-glass load-in" style="--d:0ms">Automatyzacja i AI dla firm B2B</p>
        <h1 class="display load-in" style="--d:80ms">Procesy, które robią się same</h1>
        <p class="hero-lead load-in" style="--d:160ms">Łączymy Twój CRM, ERP i skrzynki w jeden obieg, a powtarzalną pracę oddajemy agentom AI. Zespół zajmuje się klientami, nie przepisywaniem danych.</p>
        <div class="hero-cta load-in" style="--d:240ms">
          <a class="btn btn-light btn-lg" href="#kontakt">Umów bezpłatną konsultację</a>
          <a class="btn btn-glass btn-lg" href="#film">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" fill="currentColor"/></svg>
            Zobacz agenta w akcji
          </a>
        </div>
      </div>

      <aside class="hero-feed load-in" style="--d:420ms" aria-label="Przykładowy podgląd pracy automatyzacji">
        <div class="feed-head"><span class="pulse" aria-hidden="true"></span>Na żywo w Twojej firmie<span class="feed-tag">przykład</span></div>
        <ul class="feed-list" data-feed>
          <li><span class="feed-ico i-doc"></span><span><b>Faktura FV/11/0412</b> odczytana i zaksięgowana</span><time>teraz</time></li>
          <li><span class="feed-ico i-lead"></span><span><b>Lead z formularza</b> zakwalifikowany, trafił do handlowca</span><time>1 min</time></li>
          <li><span class="feed-ico i-mail"></span><span><b>Zapytanie ofertowe</b> oferta gotowa do akceptacji</span><time>3 min</time></li>
          <li><span class="feed-ico i-box"></span><span><b>Zamówienie 58 213</b> przekazane do magazynu</span><time>6 min</time></li>
        </ul>
      </aside>

      <button class="film-toggle hero-toggle" type="button" data-video-pause="hero-video" aria-label="Wstrzymaj film w tle" aria-pressed="false">
        <svg class="ic-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"/></svg>
        <svg class="ic-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" fill="currentColor"/></svg>
      </button>
    </div>
  </section>

  <!-- LICZBY -->
  <section class="stats wrap" aria-label="REVAGY w liczbach">
    <div class="stat reveal">
      <p class="stat-num"><span data-count="14">14</span> dni</p>
      <p class="stat-label">roboczych od dostępu do systemów do pierwszej automatyzacji</p>
    </div>
    <div class="stat reveal" style="--d:70ms">
      <p class="stat-num"><span data-count="3">3</span> drogi</p>
      <p class="stat-label">łączenia systemów: interfejs API, wymiana plików albo baza danych</p>
    </div>
    <div class="stat reveal" style="--d:140ms">
      <p class="stat-num"><span data-count="25">25</span> min</p>
      <p class="stat-label">trwa bezpłatna konsultacja jednego procesu</p>
    </div>
    <div class="stat reveal" style="--d:210ms">
      <p class="stat-num"><span data-count="24">24</span>/7</p>
      <p class="stat-label">agenci AI odpowiadają także po godzinach</p>
    </div>
  </section>

  <!-- MOŻLIWOŚCI: BENTO -->
  <section class="section wrap" id="mozliwosci">
    <header class="section-head reveal">
      <h2 class="h2">Jeden partner od&nbsp;pierwszej integracji do&nbsp;agentów AI</h2>
      <p class="lead">Zaczynamy od procesu, który kosztuje Was najwięcej godzin. Potem dokładamy kolejne, na tej samej platformie i z tym samym zespołem.</p>
    </header>

    <div class="bento">
      <article class="card card-mist span-7 reveal">
        <div class="card-copy">
          <h3 class="h3">Sprzedaż, która sama się porządkuje</h3>
          <p>Lead z formularza, maila czy LinkedIna trafia do CRM z uzupełnionymi danymi firmy, oceną i zadaniem dla handlowca.</p>
        </div>
        <div class="mock mock-pipeline" aria-hidden="true">
          <div class="pipe-col"><span class="pipe-title">Nowe</span><i></i><i></i></div>
          <div class="pipe-col"><span class="pipe-title">Zakwalifikowane</span><i></i></div>
          <div class="pipe-col"><span class="pipe-title">Oferta</span><i></i></div>
          <div class="pipe-card">
            <span class="pc-name">POLPAK Sp. z o.o.</span>
            <span class="pc-meta">240 szt. · B2B · PL</span>
            <span class="pc-badges"><em class="b1">nowy</em><em class="b2">ocena 87</em><em class="b3">oferta</em></span>
          </div>
        </div>
      </article>

      <article class="card card-night span-5 reveal" style="--d:80ms">
        <div class="card-copy">
          <h3 class="h3">Agenci AI na pierwszej linii</h3>
          <p>Odpowiadają na zapytania, sprawdzają stany i statusy, a trudne sprawy przekazują człowiekowi z gotowym kontekstem.</p>
        </div>
        <div class="mock mock-chat" aria-hidden="true">
          <p class="bubble in c1">Dzień dobry, czy 240 szt. profili 40×40 dostanę do piątku?</p>
          <div class="chat-slot">
            <p class="bubble typing c2"><span></span><span></span><span></span></p>
            <p class="bubble out c3">Tak. Mamy 310 szt. na stanie, dostawa w czwartek. Przesyłam ofertę do akceptacji.</p>
          </div>
          <p class="bubble note c4">Oferta OF/2219 wysłana · zadanie dla opiekuna utworzone</p>
        </div>
      </article>

      <article class="card card-accent span-5 reveal">
        <div class="card-copy">
          <h3 class="h3">Dokumenty bez przepisywania</h3>
          <p>Faktury, zamówienia i umowy są odczytywane, sprawdzane i księgowane w ERP. Człowiek zatwierdza tylko wyjątki.</p>
        </div>
        <div class="mock mock-doc" aria-hidden="true">
          <div class="doc">
            <span class="doc-title">Faktura VAT</span>
            <span class="doc-line w70"></span><span class="doc-line w45"></span>
            <span class="doc-line w85"></span><span class="doc-line w60"></span>
            <span class="doc-line w30 strong"></span>
            <span class="scan"></span>
          </div>
          <ul class="doc-fields">
            <li class="f1"><span>NIP</span><b>525-000-00-00</b></li>
            <li class="f2"><span>Kwota</span><b>18 450,00 zł</b></li>
            <li class="f3"><span>Termin</span><b>27.11.2026</b></li>
            <li class="f4 ok"><b>Zaksięgowano w ERP</b></li>
          </ul>
        </div>
      </article>

      <article class="card card-video span-7 reveal" style="--d:80ms">
        <video data-autoplay muted loop playsinline preload="none" poster={zasob('assets/video/dashboard.jpg')}>
          <source src={zasob('assets/video/dashboard.webm')} type="video/webm">
          <source src={zasob('assets/video/dashboard.mp4')} type="video/mp4">
        </video>
        <div class="card-copy on-video">
          <h3 class="h3">Raporty, które liczą się same</h3>
          <p>Dane ze sprzedaży, finansów i magazynu spotykają się w jednym pulpicie. Bez eksportów do arkuszy w piątek po południu.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- KALKULATOR -->
  <section class="section wrap" id="kalkulator">
    <div class="calc reveal">
      <div class="calc-form">
        <h2 class="h2">Policz, ile godzin odzyska Twój zespół</h2>
        <p class="lead">Przesuń suwaki. Wynik to szacunek, dokładne liczby ustalamy w audycie.</p>

        <div class="field">
          <label for="calc-people">Osoby wykonujące powtarzalne zadania <output id="out-people" for="calc-people">8</output></label>
          <input type="range" id="calc-people" min="1" max="60" step="1" value="8">
        </div>
        <div class="field">
          <label for="calc-hours">Godziny tygodniowo na osobę <output id="out-hours" for="calc-hours">6 h</output></label>
          <input type="range" id="calc-hours" min="1" max="30" step="1" value="6">
        </div>
        <div class="field">
          <label for="calc-rate">Koszt godziny pracy <output id="out-rate" for="calc-rate">65 zł</output></label>
          <input type="range" id="calc-rate" min="40" max="250" step="5" value="65">
        </div>

        <fieldset class="seg" aria-label="Zakres automatyzacji">
          <legend>Jaką część tej pracy automatyzujemy</legend>
          <input type="radio" name="share" id="share-40" value="0.4"><label for="share-40">40%</label>
          <input type="radio" name="share" id="share-60" value="0.6" checked><label for="share-60">60%</label>
          <input type="radio" name="share" id="share-80" value="0.8"><label for="share-80">80%</label>
        </fieldset>
      </div>

      <div class="calc-result" aria-live="polite">
        <p class="calc-kicker">Odzyskujecie miesięcznie</p>
        <p class="calc-big"><span id="res-hours">125</span> h</p>
        <div class="calc-bars" aria-hidden="true">
          <div class="bar-row"><span>Dziś</span><div class="bar"><i id="bar-now" style="width:100%"></i></div><b id="lab-now">208 h</b></div>
          <div class="bar-row"><span>Po wdrożeniu</span><div class="bar"><i id="bar-after" class="hot" style="width:40%"></i></div><b id="lab-after">83 h</b></div>
        </div>
        <div class="calc-split">
          <div><p class="calc-kicker">Wartość odzyskanego czasu w roku</p><p class="calc-mid"><span id="res-year">97 000</span> zł</p></div>
          <div><p class="calc-kicker">To tyle, co</p><p class="calc-mid"><span id="res-fte">0,8</span> etatu</p></div>
        </div>
        <a class="btn btn-light btn-lg" href="#kontakt">Sprawdź to na konsultacji</a>
        <p class="fineprint">Wzór: osoby × godziny × 4,33 tygodnia × udział automatyzacji. Etat liczony jako 160 h miesięcznie.</p>
      </div>
    </div>
  </section>

  <!-- PROCES: STICKY SCROLL -->
  <section class="band band-night" id="proces">
    <div class="wrap">
      <header class="section-head reveal">
        <h2 class="h2">Od audytu do działającego wdrożenia w&nbsp;czterech krokach</h2>
        <p class="lead">Każdy krok kończy się czymś, co możecie zobaczyć i policzyć.</p>
      </header>

      <div class="story" data-story>
        <ol class="story-steps">
          <li class="story-step is-active" data-step="0">
            <span class="step-no">Krok 1</span>
            <h3 class="h3">Audyt procesów</h3>
            <p>Przechodzimy z zespołem przez codzienną pracę i mierzymy, gdzie uciekają godziny. Dostajecie mapę procesów z wyceną czasu.</p>
            <p class="step-meta">Czas: 3–5 dni roboczych</p>
          </li>
          <li class="story-step" data-step="1">
            <span class="step-no">Krok 2</span>
            <h3 class="h3">Projekt i zwrot</h3>
            <p>Rysujemy docelowy przepływ i liczymy zwrot dla każdego procesu osobno. Zaczynamy od tego, który spłaci się najszybciej.</p>
            <p class="step-meta">Wynik: plan wdrożenia z budżetem</p>
          </li>
          <li class="story-step" data-step="2">
            <span class="step-no">Krok 3</span>
            <h3 class="h3">Wdrożenie i integracje</h3>
            <p>Budujemy w dwutygodniowych sprintach. Po każdym sprincie coś działa na produkcji, a zespół dostaje krótkie szkolenie.</p>
            <p class="step-meta">Pierwsza automatyzacja: 14 dni roboczych od dostępu do systemów</p>
          </li>
          <li class="story-step" data-step="3">
            <span class="step-no">Krok 4</span>
            <h3 class="h3">Opieka i rozwój</h3>
            <p>Monitorujemy przepływy, reagujemy na błędy zanim zauważy je klient i co miesiąc proponujemy kolejne usprawnienia.</p>
            <p class="step-meta">Stały opiekun i raport miesięczny</p>
          </li>
        </ol>

        <div class="story-stage">
          <div class="device">
            <div class="device-bar"><span></span><span></span><span></span><em>revagy.app / <b data-story-title>audyt</b></em><i>widok przykładowy</i></div>
            <div class="device-screen">
              <!-- 0: audyt -->
              <div class="pane is-active" data-pane="0">
                <p class="pane-title">Mapa procesów · czas tygodniowo</p>
                <ul class="audit-list">
                  <li><span>Wprowadzanie zamówień</span><div class="meter"><i style="--w:92%"></i></div><b>14 h</b></li>
                  <li><span>Faktury kosztowe</span><div class="meter"><i style="--w:74%"></i></div><b>11 h</b></li>
                  <li><span>Raporty sprzedaży</span><div class="meter"><i style="--w:60%"></i></div><b>9 h</b></li>
                  <li><span>Follow-upy do ofert</span><div class="meter"><i style="--w:47%"></i></div><b>7 h</b></li>
                  <li><span>Statusy dla klientów</span><div class="meter"><i style="--w:34%"></i></div><b>5 h</b></li>
                </ul>
                <p class="pane-foot"><b>46 h</b> tygodniowo do odzyskania</p>
              </div>
              <!-- 1: projekt -->
              <div class="pane" data-pane="1">
                <p class="pane-title">Docelowy przepływ · zapytanie ofertowe</p>
                <div class="flow">
                  <span class="node">Formularz / e-mail</span>
                  <span class="link"></span>
                  <span class="node hot">Agent AI</span>
                  <span class="link"></span>
                  <span class="node">CRM</span>
                  <span class="link"></span>
                  <span class="node">Oferta PDF</span>
                </div>
                <div class="roi">
                  <div><span>Koszt wdrożenia</span><b>zwrot po 4 mies.</b></div>
                  <div class="roi-chart"><i style="--h:22%"></i><i style="--h:38%"></i><i style="--h:55%"></i><i class="hot" style="--h:72%"></i><i class="hot" style="--h:88%"></i><i class="hot" style="--h:100%"></i></div>
                </div>
              </div>
              <!-- 2: wdrożenie -->
              <div class="pane" data-pane="2">
                <p class="pane-title">Sprint 2 z 3 · integracje</p>
                <ul class="checks">
                  <li class="done">CRM → ERP: zamówienia<em>działa</em></li>
                  <li class="done">Skrzynka ofertowa → Agent AI<em>działa</em></li>
                  <li class="done">Faktury kosztowe → księgowość<em>działa</em></li>
                  <li class="run">Magazyn → statusy dla klienta<em>testy</em></li>
                  <li>Pulpit zarządczy<em>w kolejce</em></li>
                </ul>
                <div class="progress"><i></i></div>
              </div>
              <!-- 3: opieka -->
              <div class="pane" data-pane="3">
                <p class="pane-title">Monitoring przepływów · 30 dni</p>
                <svg class="spark" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
                  <path class="spark-area" d="M0 96 C40 90 60 70 100 72 S160 44 200 50 260 30 300 34 360 14 400 18 V120 H0Z"/>
                  <path class="spark-line" d="M0 96 C40 90 60 70 100 72 S160 44 200 50 260 30 300 34 360 14 400 18" pathLength="1"/>
                </svg>
                <div class="kpis">
                  <div><b>4 812</b><span>zadań wykonanych</span></div>
                  <div><b>99,9%</b><span>poprawnych przebiegów</span></div>
                  <div><b>2</b><span>wyjątki do decyzji</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ZASTOSOWANIA: KARUZELA -->
  <section class="section" id="zastosowania">
    <div class="wrap carousel-head reveal">
      <div>
        <h2 class="h2">Co automatyzujemy w&nbsp;każdym dziale</h2>
        <p class="lead">Przykłady wdrożeń, od których firmy B2B zaczynają najczęściej. <a class="link-btn" href="wdrozenia.html">Zobacz cztery wdrożenia</a></p>
      </div>
      <div class="carousel-nav">
        <button class="round-btn" type="button" data-car-prev aria-label="Poprzednie karty">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 4 6 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="round-btn" type="button" data-car-next aria-label="Następne karty">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <div class="carousel" data-carousel tabindex="0" aria-label="Zastosowania według działu">
      <article class="use use-night">
        <span class="use-tag">Sprzedaż</span>
        <h3 class="h3">Handlowiec zaczyna dzień od gotowej listy</h3>
        <ul><li>Kwalifikacja i wzbogacanie leadów</li><li>Oferty generowane z cennika</li><li>Follow-upy wysyłane na czas</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M14 96 44 62l20 16 42-52" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="106" cy="26" r="9" fill="currentColor"/></svg>
      </article>
      <article class="use use-mist">
        <span class="use-tag">Finanse</span>
        <h3 class="h3">Faktura wchodzi i sama trafia do księgi</h3>
        <ul><li>Odczyt i kontrola faktur kosztowych</li><li>Uzgadnianie płatności z bankiem</li><li>Przypomnienia o należnościach</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><rect x="24" y="12" width="72" height="96" rx="12" fill="none" stroke="currentColor" stroke-width="7"/><path d="M42 42h36M42 60h36M42 78h18" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
      </article>
      <article class="use use-accent">
        <span class="use-tag">Obsługa klienta</span>
        <h3 class="h3">Klient dostaje odpowiedź w minutę, także w nocy</h3>
        <ul><li>Statusy zamówień i dostaw</li><li>Reklamacje z kompletem danych</li><li>Przekazanie do człowieka z kontekstem</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M18 28a12 12 0 0 1 12-12h60a12 12 0 0 1 12 12v40a12 12 0 0 1-12 12H56l-24 22V80h-2a12 12 0 0 1-12-12z" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/></svg>
      </article>
      <article class="use use-plum">
        <span class="use-tag">Marketing</span>
        <h3 class="h3">Kampanie i raporty bez ręcznego klejenia danych</h3>
        <ul><li>Leady z reklam prosto do CRM</li><li>Raport kosztu pozyskania co rano</li><li>Segmenty odświeżane automatycznie</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="7"/><path d="M60 60V16a44 44 0 0 1 38 66z" fill="currentColor"/></svg>
      </article>
      <article class="use use-mist">
        <span class="use-tag">Logistyka</span>
        <h3 class="h3">Zamówienie przechodzi z maila do magazynu</h3>
        <ul><li>Zamówienia z PDF i e-maili do ERP</li><li>Awizacje i listy przewozowe</li><li>Alerty o brakach i opóźnieniach</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><path d="M60 12 102 34v52L60 108 18 86V34z" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/><path d="M18 34 60 58l42-24M60 58v50" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/></svg>
      </article>
      <article class="use use-night">
        <span class="use-tag">HR i operacje</span>
        <h3 class="h3">Nowa osoba ma dostęp do wszystkiego pierwszego dnia</h3>
        <ul><li>Onboarding i nadawanie dostępów</li><li>Wnioski i akceptacje w jednym miejscu</li><li>Baza wiedzy z odpowiedziami AI</li></ul>
        <svg class="use-art" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="40" r="20" fill="none" stroke="currentColor" stroke-width="7"/><path d="M20 106a40 40 0 0 1 80 0" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/></svg>
      </article>
    </div>
  </section>

  <!-- INTEGRACJE: MARQUEE -->
  <section class="section section-tight" id="integracje">
    <header class="section-head wrap reveal">
      <h2 class="h2">Pracujemy na tym, co już macie</h2>
      <p class="lead">Nie wymieniamy systemów. Łączymy je tak, żeby dane przechodziły między nimi bez udziału ludzi. <a class="link-btn" href="integracja-systemow.html">Zobacz, jak łączymy systemy</a></p>
    </header>
    <div class="marquee" aria-label="Przykładowe systemy, z którymi integrujemy">
      <ul class="marquee-row" data-marquee>
        <li>Pipedrive</li><li>HubSpot</li><li>Salesforce</li><li>Asana</li><li>Slack</li><li>Microsoft 365</li><li>Google Workspace</li><li>n8n</li><li>Make</li><li>Comarch ERP</li><li>SAP</li>
      </ul>
      <ul class="marquee-row reverse" data-marquee>
        <li>BaseLinker</li><li>Shopify</li><li>WooCommerce</li><li>enova365</li><li>Subiekt</li><li>Jira</li><li>Notion</li><li>Teams</li><li>KSeF</li><li>PostgreSQL</li><li>REST i webhooki</li>
      </ul>
    </div>
  </section>

  <!-- FILM -->
  <section class="section" id="film">
    <header class="section-head wrap reveal">
      <h2 class="h2">Zapytanie ofertowe obsłużone w&nbsp;trzy minuty</h2>
      <p class="lead">Agent czyta wiadomość, sprawdza stan w ERP, przygotowuje ofertę i prosi człowieka tylko o akceptację.</p>
    </header>
    <div class="film-outer">
      <div class="film" data-scale>
        <video data-autoplay data-main-video muted loop playsinline preload="none" poster={zasob('assets/video/agent-demo.jpg')} aria-label="Animacja: agent AI obsługuje zapytanie ofertowe">
          <source src={zasob('assets/video/agent-demo.webm')} type="video/webm">
          <source src={zasob('assets/video/agent-demo.mp4')} type="video/mp4">
        </video>
        <button class="film-toggle" type="button" data-video-toggle aria-label="Wstrzymaj film" aria-pressed="false">
          <svg class="ic-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"/></svg>
          <svg class="ic-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- PAKIETY -->
  <section class="section wrap" id="pakiety">
    <header class="section-head reveal">
      <h2 class="h2">Pakiet dopasowany do etapu firmy</h2>
      <p class="lead">Wycenę podajemy po audycie, bo zależy od liczby procesów i systemów. Zakres poznasz już teraz. <a class="link-btn" href="dla-firm.html">Zobacz pakiety dla firm</a></p>
      <div class="seg seg-center" role="tablist" aria-label="Model współpracy">
        <button type="button" role="tab" aria-selected="true" data-mode="projekt">Wdrożenie</button>
        <button type="button" role="tab" aria-selected="false" data-mode="opieka">Stała opieka</button>
      </div>
    </header>

    <div class="plans" data-plans data-mode="projekt">
      <article class="plan reveal">
        <h3 class="h3">Start</h3>
        <p class="plan-for">Dla firm, które chcą sprawdzić automatyzację na jednym procesie.</p>
        <p class="plan-price">Wycena po audycie</p>
        <ul class="ticks m-projekt"><li>Audyt jednego obszaru</li><li>1 proces zautomatyzowany od początku do końca</li><li>Do 3 integracji</li><li>Szkolenie zespołu</li></ul>
        <ul class="ticks m-opieka"><li>Monitoring przepływów w dni robocze</li><li>Poprawki i drobne zmiany</li><li>Raport kwartalny</li><li>Czas reakcji zapisany w umowie</li></ul>
        <a class="btn btn-outline" href="#kontakt">Zapytaj o Start</a>
      </article>
      <article class="plan plan-featured reveal" style="--d:80ms">
        <span class="plan-flag">Najczęściej wybierany</span>
        <h3 class="h3">Scale</h3>
        <p class="plan-for">Dla zespołów, które chcą zautomatyzować cały dział.</p>
        <p class="plan-price">Wycena po audycie</p>
        <ul class="ticks m-projekt"><li>Audyt działu z mapą procesów</li><li>Do 5 procesów i agent AI</li><li>Integracje CRM, ERP i poczty</li><li>Pulpit zarządczy</li><li>Sprinty co 2 tygodnie</li></ul>
        <ul class="ticks m-opieka"><li>Monitoring przepływów z alertami</li><li>Rozwój: nowe przepływy co miesiąc</li><li>Raport miesięczny z liczbami</li><li>Krótszy czas reakcji, zapisany w umowie</li><li>Stały opiekun</li></ul>
        <a class="btn btn-accent" href="#kontakt">Zapytaj o Scale</a>
      </article>
      <article class="plan reveal" style="--d:160ms">
        <h3 class="h3">Enterprise</h3>
        <p class="plan-for">Dla organizacji z wieloma spółkami, działami i systemami. <a class="link-btn" href="produkcja-i-logistyka.html">Pilot dla produkcji i logistyki</a></p>
        <p class="plan-price">Wycena indywidualna</p>
        <ul class="ticks m-projekt"><li>Audyt całej organizacji</li><li>Program wdrożeń z kamieniami milowymi</li><li>Agenci AI na własnych danych</li><li>Wdrożenie w Waszej chmurze</li><li>Przegląd bezpieczeństwa</li></ul>
        <ul class="ticks m-opieka"><li>Monitoring w zakresie ustalonym w umowie</li><li>Dedykowany zespół</li><li>Gwarantowane czasy reakcji w umowie</li><li>Kwartalny przegląd z zarządem</li><li>Testy po każdej zmianie systemów</li></ul>
        <a class="btn btn-outline" href="#kontakt">Porozmawiajmy</a>
      </article>
    </div>
  </section>

  <!-- BEZPIECZEŃSTWO -->
  <section class="section wrap" id="bezpieczenstwo">
    <header class="section-head reveal">
      <h2 class="h2">Dane firmy zostają pod Waszą kontrolą</h2>
      <p class="lead">Automatyzacja nie może być czarną skrzynką. Każdy krok da się sprawdzić i zatrzymać. <a class="link-btn" href="dane-i-bezpieczenstwo.html">Zobacz, jak chronimy dane</a></p>
    </header>
    <div class="trio">
      <article class="trust reveal">
        <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 6 9v10c0 8.4 5.8 14.6 14 17 8.2-2.4 14-8.6 14-17V9z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/><path d="m14 20 4.5 4.5L27 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3 class="h4">Zgodność z RODO</h3>
        <p>Umowę powierzenia przygotowujemy pod Waszą organizację. Każda integracja dostaje minimalny zakres dostępu.</p>
      </article>
      <article class="trust reveal" style="--d:80ms">
        <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M6 35a14 14 0 0 1 28 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <h3 class="h4">Człowiek zatwierdza wyjątki</h3>
        <p>Ustalacie progi, powyżej których agent prosi o decyzję: kwota, rabat, nowy kontrahent, nietypowa treść.</p>
      </article>
      <article class="trust reveal" style="--d:160ms">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="7" y="5" width="26" height="30" rx="5" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M13 14h14M13 20h14M13 26h8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <h3 class="h4">Pełny dziennik działań</h3>
        <p>Każde działanie automatu ma wpis: co zrobił, na jakich danych i kiedy. Przydaje się przy audycie i reklamacji.</p>
      </article>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section wrap faq-section" id="faq">
    <header class="section-head left reveal">
      <h2 class="h2">Najczęstsze pytania</h2>
      <p class="lead">Nie ma tu Twojego? Zadaj je na konsultacji, jest bezpłatna.</p>
    </header>
    <div class="faq" data-faq>
      <div class="qa is-open">
        <h3><button type="button" aria-expanded="true" aria-controls="qa-1" id="qb-1">Od czego zacząć, jeśli nigdy nie automatyzowaliśmy?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-1" role="region" aria-labelledby="qb-1"><div><p>Od jednego procesu, który jest powtarzalny, częsty i dobrze opisany, na przykład wprowadzania zamówień albo faktur kosztowych. Audyt pokaże, który z Waszych procesów zwróci się najszybciej.</p></div></div>
      </div>
      <div class="qa">
        <h3><button type="button" aria-expanded="false" aria-controls="qa-2" id="qb-2">Czy musimy zmieniać CRM albo ERP?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-2" role="region" aria-labelledby="qb-2"><div><p>Nie. Pracujemy na obecnych systemach i łączymy je przez API, webhooki lub pliki wymiany. Wymianę systemu doradzamy tylko wtedy, gdy blokuje on integrację.</p></div></div>
      </div>
      <div class="qa">
        <h3><button type="button" aria-expanded="false" aria-controls="qa-3" id="qb-3">Ile trwa wdrożenie?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-3" role="region" aria-labelledby="qb-3"><div><p>Pierwsza automatyzacja działa po 14 dniach roboczych od dnia, w którym mamy dostęp do systemów. Wdrożenie dla całego działu to najczęściej 6–10 tygodni, prowadzone w dwutygodniowych sprintach.</p></div></div>
      </div>
      <div class="qa">
        <h3><button type="button" aria-expanded="false" aria-controls="qa-4" id="qb-4">Co się dzieje, gdy agent AI się pomyli?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-4" role="region" aria-labelledby="qb-4"><div><p>Agent działa w ustalonych granicach. Sprawy niepewne lub powyżej progu trafiają do człowieka. Każde działanie jest zapisane w dzienniku, więc błąd da się odnaleźć i cofnąć.</p></div></div>
      </div>
      <div class="qa">
        <h3><button type="button" aria-expanded="false" aria-controls="qa-5" id="qb-5">Gdzie przetwarzane są nasze dane?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-5" role="region" aria-labelledby="qb-5"><div><p>Umowę powierzenia przygotowujemy pod Waszą organizację przed startem prac i wskazujemy w niej, gdzie dane są przetwarzane.</p></div></div>
      </div>
      <div class="qa">
        <h3><button type="button" aria-expanded="false" aria-controls="qa-6" id="qb-6">Ile kosztuje audyt?<span class="plus" aria-hidden="true"></span></button></h3>
        <div class="qa-body" id="qa-6" role="region" aria-labelledby="qb-6"><div><p>Konsultacja jednego procesu trwa 25 minut i jest bezpłatna. Dostajecie po niej jednostronicową kartę procesu. Audyt kosztuje 1 990 zł i jest w całości wliczany we wdrożenie.</p></div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" id="kontakt">
    <div class="cta">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-inner">
        <h2 class="display-2">Sprawdź, co w Twojej firmie może robić się samo</h2>
        <p class="lead">Napisz do nas ze służbowej skrzynki. Wrócimy z terminem bezpłatnej konsultacji.</p>
        {TURNSTILE_SITEKEY && (
          <form id="kontakt-form" class="kontakt-form" action="/api/kontakt" method="post" novalidate data-notice-version={KONTAKT_NOTICE.version} data-sitekey={TURNSTILE_SITEKEY}>
            <p class="kontakt-help">Pola oznaczone „wymagane” trzeba uzupełnić.</p>
            <div class="kontakt-grid">
              <div class="kontakt-field">
                <label for="kontakt-name">Imię i nazwisko (wymagane)</label>
                <input id="kontakt-name" name="name" type="text" autocomplete="name" maxlength="120" minlength="2" required aria-required="true" aria-describedby="kontakt-name-error" aria-invalid="false">
                <span id="kontakt-name-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-email">Służbowy e-mail (wymagane)</label>
                <input id="kontakt-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-required="true" aria-describedby="kontakt-email-error" aria-invalid="false">
                <span id="kontakt-email-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-company">Firma (wymagane)</label>
                <input id="kontakt-company" name="company" type="text" autocomplete="organization" maxlength="160" required aria-required="true" aria-describedby="kontakt-company-error" aria-invalid="false">
                <span id="kontakt-company-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-phone">Telefon (opcjonalnie)</label>
                <input id="kontakt-phone" name="phone" type="tel" autocomplete="tel" maxlength="32" minlength="6" pattern="[+0-9 \(\)\-]{6,32}" aria-describedby="kontakt-phone-error" aria-invalid="false">
                <span id="kontakt-phone-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-topic">Temat (wymagane)</label>
                <select id="kontakt-topic" name="topic" required aria-required="true" aria-describedby="kontakt-topic-error" aria-invalid="false">
                  <option value="">Wybierz temat</option>
                  <option value="audyt">Konsultacja jednego procesu</option>
                  <option value="wdrozenie">Wdrożenie</option>
                  <option value="kalkulator-roi">Kalkulator zwrotu (ROI)</option>
                  <option value="inne">Inne</option>
                </select>
                <span id="kontakt-topic-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-volume">Ilu pracowników lub kandydatów miesięcznie obsługujecie? (opcjonalnie)</label>
                <select id="kontakt-volume" name="volume" aria-describedby="kontakt-volume-error" aria-invalid="false">
                  <option value="">Nie podaję</option>
                  <option value="do-50">do 50</option>
                  <option value="50-200">50–200</option>
                  <option value="200-1000">200–1000</option>
                  <option value="ponad-1000">ponad 1000</option>
                </select>
                <span id="kontakt-volume-error" class="kontakt-error"></span>
              </div>
            </div>
            <div class="kontakt-field">
              <label for="kontakt-message">Wiadomość (opcjonalnie)</label>
              <textarea id="kontakt-message" name="message" rows="6" maxlength="4000" aria-describedby="kontakt-message-count kontakt-message-error" aria-invalid="false"></textarea>
              <span id="kontakt-message-count">0 / 4000 znaków</span>
              <span id="kontakt-message-error" class="kontakt-error"></span>
            </div>
            <div class="kontakt-honeypot" aria-hidden="true">
              <label for="kontakt-website">Zostaw to pole puste</label>
              <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>
            <div id="kontakt-challenge" aria-describedby="kontakt-challenge-error"></div>
            <p id="kontakt-challenge-error" class="kontakt-error"></p>
            <button class="btn btn-accent btn-lg" type="submit" disabled aria-busy="false">Wyślij zapytanie</button>
            <p class="kontakt-notice">{KONTAKT_NOTICE.text}<a href="/polityka-prywatnosci.html">{KONTAKT_NOTICE.url}</a></p>
            <p class="kontakt-status" data-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
            <noscript><p>Do wysłania formularza potrzebna jest obsługa JavaScript. Napisz: <a href="mailto:kontakt@revagy.pl">kontakt@revagy.pl</a>.</p></noscript>
          </form>
        )}
        <div class="cta-form">
          <a class="cta-mail" href="mailto:kontakt@revagy.pl?subject=Bezp%C5%82atna%20konsultacja" data-track="E-mail: adres">kontakt@revagy.pl</a>
          <a class="btn btn-accent btn-lg" href="mailto:kontakt@revagy.pl?subject=Bezp%C5%82atna%20konsultacja" data-track="E-mail: Umów konsultację">Umów konsultację</a>
        </div>
        <p class="form-msg"><button type="button" class="link-btn" data-copy="kontakt@revagy.pl" data-track="Kopiuj adres">Kopiuj adres</button><span data-copy-msg role="status"></span></p>
      </div>
    </div>
  </section>
</main>
</BaseLayout>
