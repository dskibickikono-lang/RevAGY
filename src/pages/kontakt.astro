---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TURNSTILE_SITEKEY, KONTAKT_NOTICE } from '../config/kontakt';
---
<BaseLayout
  title="Kontakt — REVAGY"
  description="Napisz do REVAGY ze służbowej skrzynki. Wrócimy z terminem bezpłatnej konsultacji jednego procesu."
  canonical="https://revagy.pl/kontakt.html"
  variant="subpage"
  hasForm={Boolean(TURNSTILE_SITEKEY)}
>
<main id="start">
  <section class="section" id="kontakt">
    <div class="cta">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-inner">
        <h1 class="display-2">Sprawdź, co w Twojej firmie może robić się samo</h1>
        <p class="lead">Napisz do nas ze służbowej skrzynki. Wrócimy z terminem bezpłatnej konsultacji.</p>
        {TURNSTILE_SITEKEY && (
          <form id="kontakt-form" class="kontakt-form" action="/api/kontakt" method="post" novalidate data-notice-version={KONTAKT_NOTICE.version} data-sitekey={TURNSTILE_SITEKEY}>
            <p class="kontakt-help">Pola oznaczone „wymagane” trzeba uzupełnić.</p>
            <div class="kontakt-grid">
              <div class="kontakt-field">
                <label for="kontakt-name">Imię i nazwisko (wymagane)</label>
                <input id="kontakt-name" name="name" type="text" autocomplete="name" maxlength="120" minlength="2" required aria-required="true" aria-describedby="kontakt-name-error" aria-invalid="false">
                <span id="kontakt-name-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-email">Służbowy e-mail (wymagane)</label>
                <input id="kontakt-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-required="true" aria-describedby="kontakt-email-error" aria-invalid="false">
                <span id="kontakt-email-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-company">Firma (wymagane)</label>
                <input id="kontakt-company" name="company" type="text" autocomplete="organization" maxlength="160" required aria-required="true" aria-describedby="kontakt-company-error" aria-invalid="false">
                <span id="kontakt-company-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-phone">Telefon (opcjonalnie)</label>
                <input id="kontakt-phone" name="phone" type="tel" autocomplete="tel" maxlength="32" minlength="6" pattern="[+0-9 \(\)\-]{6,32}" aria-describedby="kontakt-phone-error" aria-invalid="false">
                <span id="kontakt-phone-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-topic">Temat (wymagane)</label>
                <select id="kontakt-topic" name="topic" required aria-required="true" aria-describedby="kontakt-topic-error" aria-invalid="false">
                  <option value="">Wybierz temat</option>
                  <option value="audyt">Konsultacja jednego procesu</option>
                  <option value="wdrozenie">Wdrożenie</option>
                  <option value="kalkulator-roi">Kalkulator zwrotu (ROI)</option>
                  <option value="inne">Inne</option>
                </select>
                <span id="kontakt-topic-error" class="kontakt-error"></span>
              </div>
              <div class="kontakt-field">
                <label for="kontakt-volume">Ilu pracowników lub kandydatów miesięcznie obsługujecie? (opcjonalnie)</label>
                <select id="kontakt-volume" name="volume" aria-describedby="kontakt-volume-error" aria-invalid="false">
                  <option value="">Nie podaję</option>
                  <option value="do-50">do 50</option>
                  <option value="50-200">50–200</option>
                  <option value="200-1000">200–1000</option>
                  <option value="ponad-1000">ponad 1000</option>
                </select>
                <span id="kontakt-volume-error" class="kontakt-error"></span>
              </div>
            </div>
            <div class="kontakt-field">
              <label for="kontakt-message">Wiadomość (opcjonalnie)</label>
              <textarea id="kontakt-message" name="message" rows="6" maxlength="4000" aria-describedby="kontakt-message-count kontakt-message-error" aria-invalid="false"></textarea>
              <span id="kontakt-message-count">0 / 4000 znaków</span>
              <span id="kontakt-message-error" class="kontakt-error"></span>
            </div>
            <div class="kontakt-honeypot" aria-hidden="true">
              <label for="kontakt-website">Zostaw to pole puste</label>
              <input id="kontakt-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>
            <div id="kontakt-challenge" aria-describedby="kontakt-challenge-error"></div>
            <p id="kontakt-challenge-error" class="kontakt-error"></p>
            <button class="btn btn-accent btn-lg" type="submit" disabled aria-busy="false">Wyślij zapytanie</button>
            <p class="kontakt-notice">{KONTAKT_NOTICE.text}<a href="/polityka-prywatnosci.html">{KONTAKT_NOTICE.url}</a></p>
            <p class="kontakt-status" data-status role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
            <noscript><p>Do wysłania formularza potrzebna jest obsługa JavaScript. Napisz: <a href="mailto:kontakt@revagy.pl">kontakt@revagy.pl</a>.</p></noscript>
          </form>
        )}
        <div class="cta-form">
          <a class="cta-mail" href="mailto:kontakt@revagy.pl?subject=Bezp%C5%82atna%20konsultacja" data-track="Kontakt E-mail: adres">kontakt@revagy.pl</a>
          <a class="btn btn-accent btn-lg" href="mailto:kontakt@revagy.pl?subject=Bezp%C5%82atna%20konsultacja" data-track="Kontakt E-mail: Umów konsultację">Umów konsultację</a>
        </div>
      </div>
    </div>
  </section>
</main>
</BaseLayout>
